rule header_info:
    input:
        pgen=get_pgen(),
    output:
        info=ws_path("pgen/impute_dedup_{chrom}.info"),
    container:
        "docker://quay.io/biocontainers/plink2:2.00a5--h4ac6f70_0"
    resources:
        runtime=lambda wc, attempt: attempt * 10,
    shell:
        """PFILE=$(echo "{input}" | sed 's/\.[^.]*$//');
plink2 \
--pfile $PFILE \
--pgen-info \
--memory 3000 \
--threads {resources.threads} &> {output.info}
"""
