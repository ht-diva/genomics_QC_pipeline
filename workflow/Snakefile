from snakemake.utils import min_version
from pathlib import Path

##### set minimum snakemake version #####
min_version("8.4.1")


configfile: "config/config.example.yaml"


include: "rules/common.smk"
include: "rules/bed.smk"


if config.get("run").get("delivery"):

    include: "rules/delivery.smk"


rule all:
    input:
        get_final_output(),


rule list_rs:
    input:
        directory_path=expand(get_pvar(), chrom=get_chromosomes()),
    output:
        list_merge_rsid=ws_path("pgen/merge_rsids.txt"),
        list_recode_rsid=ws_path("pgen/recode_rsids.txt"),
        list_pseudo_biallelic_var=ws_path("pgen/pseudo_biallelic_var.txt"),
        list_pseudo_biallelic=ws_path("pgen/pseudo_biallelic.txt"),
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    shell:
        """
tail -n +2 -q {input.directory_path} > {output.list_merge_rsid} && \
awk -F'\t' '$2 in a{{if(a[$2])print a[$2];a[$2]=""; print; next}} {{a[$2]=$0}}' {output.list_merge_rsid} > {output.list_pseudo_biallelic_var} && \
awk -v OFS="\t" 'BEGIN {{print "RSID", "ID"}} {{print $3, $1":"$2":"$4":"$5}}' {output.list_pseudo_biallelic_var} > {output.list_pseudo_biallelic} && \
awk -v OFS="\t" 'BEGIN {{print "SNPID", "rsID", "CHR", "POS", "NEA", "EA"}} {{print $1":"$2":"$4":"$5, $3, $1, $2, $4, $5}}' {output.list_merge_rsid} > {output.list_recode_rsid}
"""


rule build_snp_mapping_files:
    input:
        get_pvar(),
    output:
        mapping_table=ws_path(
            "snp_mapping/{chrom}/snp_mapping/table.snp_mapping.tsv.gz"
        ),
        table=ws_path("snp_mapping/{chrom}/outputs/{chrom}/{chrom}.gwaslab.tsv.gz"),
    container:
        "docker://ghcr.io/ht-diva/gwaspipe:7a17c0"
    params:
        config_file=config.get("config_file_path"),
        output_path=ws_path("snp_mapping/{chrom}/"),
    shell:
        "gwaspipe "
        "-f plink_pvar "
        "-i {input} "
        "-c {params.config_file} "
        "-o {params.output_path}"


rule get_mirror_snps:
    input:
        get_pvar(),
    output:
        ws_path("pgen/filtering/mirror_snps_{chrom}.txt"),
    container:
        "docker://ghcr.io/ht-diva/containers/python_ds:406993"
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    shell:
        "python workflow/scripts/get_mirror_snps.py "
        "--input_file {input} "
        "--column ID "
        "--output_file {output}"


rule filter_mirror_snps:
    input:
        rules.get_mirror_snps.output,
        get_pgen(),
    output:
        temp(ws_path("pgen/filtering/impute_filtered_mirror_snps_{chrom}.pgen")),
        temp(ws_path("pgen/filtering/impute_filtered_mirror_snps_{chrom}.pvar")),
        temp(ws_path("pgen/filtering/impute_filtered_mirror_snps_{chrom}.psam")),
    container:
        "docker://quay.io/biocontainers/plink2:2.00a5--h4ac6f70_0"
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    params:
        pfile=get_pgen(stem=True),
        prefix=ws_path("pgen/filtering/impute_filtered_mirror_snps_{chrom}"),
    shell:
        """plink2 \
 --pfile {params.pfile} \
 --exclude {input[0]} \
 --make-pgen \
 --out {params.prefix} \
 --threads {resources.threads} \
 --memory 1900 'require'
 """


rule filter_problematic_snps:
    input:
        rules.filter_mirror_snps.output,
    output:
        temp(ws_path("pgen/filtering/filtered_problematic_snps_{chrom}.pgen")),
        temp(ws_path("pgen/filtering/filtered_problematic_snps_{chrom}.pvar")),
        temp(ws_path("pgen/filtering/filtered_problematic_snps_{chrom}.psam")),
    container:
        "docker://quay.io/biocontainers/plink2:2.00a5--h4ac6f70_0"
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    params:
        pfile=rules.filter_mirror_snps.params.prefix,
        prefix=ws_path("pgen/filtering/filtered_problematic_snps_{chrom}"),
        problematic_snps=config.get("problematic_snps_path"),
    shell:
        """plink2 \
 --pfile {params.pfile} \
 --exclude {params.problematic_snps} \
 --make-pgen \
 --out {params.prefix} \
 --threads {resources.threads} \
 --memory 1900 'require'
 """


rule recode_pgen:
    input:
        branch(
            lookup(dpath="run/filter_problematic_snps", within=config),
            then=rules.filter_problematic_snps.output,
            otherwise=rules.filter_mirror_snps.output,
        ),
    output:
        ws_path("pgen/qc_recoded/impute_dedup_recoded_{chrom}.pgen"),
        ws_path("pgen/qc_recoded/impute_dedup_recoded_{chrom}.pvar"),
        ws_path("pgen/qc_recoded/impute_dedup_recoded_{chrom}.psam"),
    container:
        "docker://quay.io/biocontainers/plink2:2.00a5--h4ac6f70_0"
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    params:
        prefix=ws_path("pgen/qc_recoded/impute_dedup_recoded_{chrom}"),
        pfile=branch(
            lookup(dpath="run/filter_problematic_snps", within=config),
            then=ws_path("pgen/filtering/filtered_problematic_snps_{chrom}"),
            otherwise=ws_path("pgen/filtering/impute_filtered_mirror_snps_{chrom}"),
        ),
    shell:
        """plink2 \
--pfile {params.pfile} \
--set-all-var-ids '@:#:$r:$a' \
--new-id-max-allele-len 1000 \
--make-pgen \
--out {params.prefix} \
--threads {resources.threads} \
--memory 90000 'require'
"""


rule selected_sample:
    input:
        rules.recode_pgen.output,
    output:
        ws_path("pgen/qc_recoded/impute_recoded_selected_sample_{chrom}.pgen"),
        ws_path("pgen/qc_recoded/impute_recoded_selected_sample_{chrom}.pvar"),
        ws_path("pgen/qc_recoded/impute_recoded_selected_sample_{chrom}.psam"),
    container:
        "docker://quay.io/biocontainers/plink2:2.00a5--h4ac6f70_0"
    resources:
        runtime=lambda wc, attempt: attempt * 60,
    params:
        fam=config.get("fam_path"),
        pfile=ws_path("pgen/qc_recoded/impute_dedup_recoded_{chrom}"),
        prefix=ws_path("pgen/qc_recoded/impute_recoded_selected_sample_{chrom}"),
        mind=config.get("plink2_dict").get("mind"),
    shell:
        """plink2 \
--pfile {params.pfile} \
--keep-fam {params.fam} \
--make-pgen \
--mind {params.mind} \
--out {params.prefix} \
--threads {resources.threads} \
--memory 90000 'require'
"""


